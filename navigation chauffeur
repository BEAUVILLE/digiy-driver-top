// Fonction pour ouvrir Google Maps avec l'itinéraire
function naviguerVersClient(clientLat, clientLng, clientNom) {
    // Vérifie si on a les coordonnées
    if (!clientLat || !clientLng) {
        alert('❌ Position du client non disponible');
        return;
    }

    // Détecte si c'est mobile ou desktop
    const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
    
    if (isMobile) {
        // Sur mobile : ouvre l'app Google Maps directement
        // Format : google.navigation permet d'ouvrir en mode navigation directe
        const googleMapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${clientLat},${clientLng}&travelmode=driving`;
        
        // Alternative : mode navigation directe (démarre la nav auto)
        // const googleMapsUrl = `google.navigation:q=${clientLat},${clientLng}`;
        
        window.open(googleMapsUrl, '_blank');
    } else {
        // Sur desktop : ouvre Google Maps dans un nouvel onglet
        const googleMapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${clientLat},${clientLng}&travelmode=driving`;
        window.open(googleMapsUrl, '_blank');
    }
    
    console.log(`🚗 Navigation vers ${clientNom || 'client'} : ${clientLat}, ${clientLng}`);
}

// Fonction pour ouvrir Waze (alternative)
function naviguerAvecWaze(clientLat, clientLng) {
    const wazeUrl = `https://waze.com/ul?ll=${clientLat},${clientLng}&navigate=yes`;
    window.open(wazeUrl, '_blank');
}

// Fonction pour choisir l'app de navigation
function choisirNavigation(clientLat, clientLng, clientNom) {
    const choice = confirm(
        `🚗 Naviguer vers ${clientNom || 'le client'}\n\n` +
        `OK = Google Maps\n` +
        `Annuler = Waze`
    );
    
    if (choice) {
        naviguerVersClient(clientLat, clientLng, clientNom);
    } else {
        naviguerAvecWaze(clientLat, clientLng);
    }
}

