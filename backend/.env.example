# ========================================
# DIGIY DRIVER - Configuration Backend
# ========================================
# INSTRUCTIONS:
# 1. Copier ce fichier: cp .env.example .env
# 2. Remplir TOUTES les valeurs ci-dessous
# 3. Ne JAMAIS commit le fichier .env !
# ========================================

# Environnement (development | production)
NODE_ENV=development

# Serveur
PORT=5000

# ========================================
# 🔴 OBLIGATOIRE - MongoDB
# ========================================
# Créer un cluster gratuit sur https://cloud.mongodb.com
# Format: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DATABASE
MONGODB_URI=

# ========================================
# 🔴 OBLIGATOIRE - JWT Secret
# ========================================
# Générer une clé sécurisée avec: openssl rand -hex 64
# Doit être une chaîne longue et aléatoire (min 64 caractères)
JWT_SECRET=
JWT_EXPIRE=7d

# ========================================
# 🔴 OBLIGATOIRE - Admin Initial
# ========================================
# Credentials pour le premier admin (utilisé par le seeder)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=DIGIY Admin

# ========================================
# ⚙️ OPTIONNEL - Configuration avancée
# ========================================

# Rate Limiting (protection contre les abus)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Frontend URL (pour CORS)
FRONTEND_URL=http://localhost:3000

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:3000

# CORS Origins (séparés par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
